#!/bin/sh
set -eu

plugin_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
runtime_root="$plugin_root/runtime"
cache_root=${RIGOL_UV_CACHE_DIR:-${TMPDIR:-/tmp}/rigol-ds1102e-uv-cache}

if [ ! -f "$runtime_root/pyproject.toml" ]; then
  echo "packaged runtime missing: $runtime_root" >&2
  exit 2
fi

if [ -x "$runtime_root/.venv/bin/python" ]; then
  exec "$runtime_root/.venv/bin/python" -m rigol_tool.cli "$@"
fi

for site_packages in "$runtime_root"/.venv/lib/python*/site-packages; do
  if [ -d "$site_packages" ] && command -v python3 >/dev/null 2>&1; then
    exec env PYTHONPATH="$runtime_root/src:$site_packages${PYTHONPATH:+:$PYTHONPATH}" \
      python3 -m rigol_tool.cli "$@"
  fi
done

exec env UV_CACHE_DIR="$cache_root" uv run --frozen --project "$runtime_root" rigol "$@"
